# render-svc — Go fetch/render service with a bounded shared headless Chrome.
# Build context is the repo root (matches the other infra/Dockerfile.* images):
#   docker build -f infra/Dockerfile.render -t localhost:5050/jh-render:local .
#
# Stage 1: compile a static Go binary.
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY services/render/go.mod services/render/go.sum ./
RUN go mod download
COPY services/render/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /render-svc .

# Stage 2: chromedp's headless-shell base ships a known-good headless Chrome at
# /headless-shell/headless-shell. We override its entrypoint to run render-svc
# and point the allocator at that binary via RENDER_CHROME_PATH.
FROM chromedp/headless-shell:latest
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates dumb-init \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /render-svc /usr/local/bin/render-svc
ENV RENDER_CHROME_PATH=/headless-shell/headless-shell \
    RENDER_MAX_TABS=3 \
    RENDER_NAV_TIMEOUT_MS=45000 \
    PORT=8080
EXPOSE 8080
ENTRYPOINT ["dumb-init", "--"]
CMD ["render-svc"]
